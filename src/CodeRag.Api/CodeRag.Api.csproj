<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>27fc462a-4137-4b87-b7b7-7bb7e33e5693</UserSecretsId>
    <!-- Required for AddOpenApi() to pick up XML doc comments as operation/schema descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlogDoFT.Libs.ResultPattern" Version="1.11.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Roslynator.Analyzers" Version="5.0.0" />
    <PackageReference Include="Roslynator.CodeFixes" Version="5.0.0" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeRag.Application\CodeRag.Application.csproj" />
    <ProjectReference Include="..\CodeRag.Infrastructure.Database\CodeRag.Infrastructure.Database.csproj" />
    <ProjectReference Include="..\CodeRag.Embeddings.Abstraction\CodeRag.Embeddings.Abstraction.csproj" />
    <ProjectReference Include="..\CodeRag.Embeddings.Local\CodeRag.Embeddings.Local.csproj" />
    <ProjectReference Include="..\CodeRag.Embeddings.Ollama\CodeRag.Embeddings.Ollama.csproj" />
    <ProjectReference Include="..\CodeRag.Embeddings.OpenAI\CodeRag.Embeddings.OpenAI.csproj" />
    <ProjectReference Include="..\CodeRag.Mcp\CodeRag.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" />
  </ItemGroup>

</Project>
