{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName"
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=192.168.1.212;Port=5432;Database=coderag;Username=coderag;Password=coderag"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Model": "bge-m3",
    "BaseUrl": "http://192.168.1.212:11434",
    "ApiKey": "",
    "Dimensions": 1024,
    "Normalized": true,
    "LocalModelPath": "",
    "TimeoutSeconds": 30
  },
  "Reranking": {
    "Provider": "",
    "Model": "",
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "CandidatePoolSize": 25,
    "MaxConcurrency": 4
  }
}