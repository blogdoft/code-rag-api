{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=coderag;Username=coderag;Password=coderag"
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Model": "bge-m3",
    "BaseUrl": "http://localhost:11434",
    "ApiKey": "",
    "Dimensions": 1024,
    "Normalized": true,
    "LocalModelPath": "",
    "TimeoutSeconds": 30
  }
}
